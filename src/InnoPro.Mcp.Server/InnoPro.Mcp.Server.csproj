<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>vn-revit-mcp</AssemblyName>
    <RootNamespace>InnoPro.Mcp.Server</RootNamespace>
    <Description>MCP server của vn-revit-mcp: công bố các lệnh Revit thành tool cho mọi AI client hỗ trợ MCP.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InnoPro.Bridge\InnoPro.Bridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Công thức quy trình (MCP prompts): file Markdown, ai cũng đóng góp được. -->
    <None Update="recipes\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="skills\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
