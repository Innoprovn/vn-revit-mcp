<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Description>CommandSet Giao diện Revit: bản đồ ribbon, kích hoạt lệnh có sẵn của Revit, trạng thái giao diện cho AI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="$(RevitApiVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chỉ dùng System.Drawing để chụp/vẽ ảnh; bỏ using ngầm định của WinForms cho khỏi trùng tên với Revit API (View, Rectangle...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InnoPro.Revit.Sdk\InnoPro.Revit.Sdk.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="commandset.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
