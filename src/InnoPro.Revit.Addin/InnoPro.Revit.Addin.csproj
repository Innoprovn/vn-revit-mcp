<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <!-- Lõi add-in: bộ nạp InnoPro.Revit.Addin.dll (src/InnoPro.Revit.Loader) nạp DLL này và nạp nóng khi có bản mới. -->
    <AssemblyName>InnoPro.Revit.Core</AssemblyName>
    <RootNamespace>InnoPro.Revit.Addin</RootNamespace>
    <Description>Lõi add-in Revit của vn-revit-mcp: tab InnoPro, nạp CommandSet, cầu nối tới MCP server.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Biên dịch file lệnh .cs và nút ribbon lúc chạy. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Thư viện mặc định không chép DLL của gói NuGet; add-in cần Roslyn đi kèm. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InnoPro.Revit.Sdk\InnoPro.Revit.Sdk.csproj" />
    <ProjectReference Include="..\InnoPro.Bridge\InnoPro.Bridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Giao diện tự vẽ dùng chung với module chat. -->
    <Compile Include="..\Shared\Ui\*.cs" Link="Ui\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project WPF bỏ System.IO khỏi implicit usings vì trùng tên System.Windows.Shapes.Path. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Update="InnoPro.VnRevitMcp.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
