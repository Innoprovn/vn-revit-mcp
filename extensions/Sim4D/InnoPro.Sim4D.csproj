<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>InnoPro.Sim4D</AssemblyName>
    <RootNamespace>BIMTech4D</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Tiến độ gắn phần tử, Gantt, chạy mô phỏng theo ngày ngay trong Revit; AI tự sinh tiến độ và hiển thị mô hình tại một ngày.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- SDK do host cung cấp lúc chạy, không chép kèm. -->
    <ProjectReference Include="..\..\src\InnoPro.Revit.Sdk\InnoPro.Revit.Sdk.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="commandset.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
